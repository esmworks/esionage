# Public URL of the app (used for OAuth issuer, MCP resource and cookies)
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://esionage:esionage@localhost:5432/esionage
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Close sign-up after creating your own account. Existing accounts can still sign in.
# DISABLE_SIGNUP=true
# docker compose only: run the bundled PostgreSQL. Remove this line to use an external database.
COMPOSE_PROFILES=bundled-db
# docker compose only: PostgreSQL password, applied when the database volume is first created.
# If you change it, update DATABASE_URL above to match.
# POSTGRES_PASSWORD=esionage
# docker compose only: connection URL of an external PostgreSQL 18 (used when the bundled one is off)
# EXTERNAL_DATABASE_URL=postgres://user:password@host:5432/esionage
# docker compose only: host port for PostgreSQL (bound to 127.0.0.1)
# DB_PORT=5432
# docker compose only: image tag to run, e.g. 0.1.0 (default: latest)
# ESIONAGE_VERSION=latest
