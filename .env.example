# Public URL of the app (used for OAuth issuer, MCP resource and cookies)
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://esionage:esionage@localhost:5432/esionage
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Close sign-up after creating your own account. Existing accounts can still sign in, and people
# you invite from Settings → Members can sign up through their invitation link.
# DISABLE_SIGNUP=true
# Reverse proxies in front of the app (Traefik, Caddy, nginx...), used to find a visitor's address
# for public form limits. Set 0 when clients reach the app directly, 2 behind a CDN plus a proxy.
# TRUSTED_PROXIES=1
# Email (SMTP), needed for invitations and password reset. Without it, development prints
# emails to the server log and production turns those features off. Test with: pnpm mail:test you@example.com
# Either a URL (smtps:// for implicit TLS on 465, smtp:// upgrades with STARTTLS)...
# SMTP_URL=smtp://user:password@smtp.example.com:587
# ...or separate settings. SMTP_PORT defaults to 587, or 465 when SMTP_SECURE=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Sender address; required when SMTP is set.
# MAIL_FROM="Esionage <no-reply@example.com>"
# Sign in with GitHub and/or Google: set both values of a provider to turn it on. Register the
# callback URL <APP_URL>/api/auth/callback/github (or /google) with the provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# File uploads (images, video, audio and attachments in pages). By default they are stored on disk
# in UPLOAD_DIR (./data/uploads; the `uploads` volume under docker compose).
# UPLOAD_DIR=./data/uploads
# Largest file, in MB (default 50), and the most one workspace may store, in MB (default 10240; 0 = no limit).
# UPLOAD_MAX_FILE_MB=50
# UPLOAD_WORKSPACE_QUOTA_MB=10240
# S3-compatible storage instead (AWS S3, Cloudflare R2, MinIO...): setting S3_BUCKET switches to it.
# Existing files are not moved when you switch.
# S3_BUCKET=esionage
# The service's URL for R2, MinIO and others; leave out for AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Address the bucket by path; default true with S3_ENDPOINT, false for AWS.
# S3_FORCE_PATH_STYLE=true
# Optional folder inside the bucket.
# S3_PREFIX=uploads
# docker compose only: run the bundled PostgreSQL. Remove this line to use an external database.
COMPOSE_PROFILES=bundled-db
# docker compose only: PostgreSQL password, applied when the database volume is first created.
# If you change it, update DATABASE_URL above to match.
# POSTGRES_PASSWORD=esionage
# docker compose only: connection URL of an external PostgreSQL 18 (used when the bundled one is off)
# EXTERNAL_DATABASE_URL=postgres://user:password@host:5432/esionage
# docker compose only: host port for PostgreSQL (bound to 127.0.0.1)
# DB_PORT=5432
# docker compose only: image tag to run, e.g. 0.2.0 (default: latest)
# ESIONAGE_VERSION=latest
