{
  "name": "esionage",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --output src/db/schema/auth.ts --adapter drizzle --dialect postgresql --yes"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.6",
    "@better-auth/mcp": "^1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@blocknote/server-util": "^0.55.0",
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@modelcontextprotocol/server": "^2.1.0",
    "better-auth": "^1.7.6",
    "crossws": "^0.4.12",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-intl": "4.14.7",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "1.7.6",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0"
}
